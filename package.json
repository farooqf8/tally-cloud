{
  "name": "tally-cloud",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
